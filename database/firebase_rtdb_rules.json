{
  "rules": {
    "tracking": {
      "$school_id": {
        // READ: Only authenticated users whose Firebase custom token embeds
        //       a school_id that matches this path segment can read.
        //       This enforces absolute multi-tenant isolation.
        ".read": "auth != null && auth.token.school_id === $school_id",

        "$bus_id": {
          // WRITE: Only authenticated drivers whose school_id matches this path
          //        can write to their specific bus node.
          //        Drivers cannot write to other schools OR other buses in their school.
          ".write": "auth != null && auth.token.role === 'driver' && auth.token.school_id === $school_id",

          // Data shape validation — enforce that all required fields are present
          // and that location_name is a non-empty string.
          ".validate": "newData.hasChildren(['location_name', 'status', 'last_updated_ts', 'bus_number'])",

          "location_name":    { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length < 200" },
          "status":           { ".validate": "newData.isString() && (newData.val() === 'en_route' || newData.val() === 'trip_ended' || newData.val() === 'idle')" },
          "last_updated_ts":  { ".validate": "newData.isNumber() && newData.val() > 0" },
          "bus_number":       { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length < 20" },
          "driver_name":      { ".validate": "newData.isString() && newData.val().length < 100" }
        }
      }
    },

    // Explicitly deny all other paths
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
